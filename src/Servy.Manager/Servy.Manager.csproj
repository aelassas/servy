<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
    <InvariantGlobalization>false</InvariantGlobalization>

    <ApplicationIcon>servy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>Servy.Manager</AssemblyTitle>
    <AssemblyDescription>A tool to manage services installed by Servy</AssemblyDescription>
    <Product>Servy.Manager</Product>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\handle64.exe" />
    <None Remove="Resources\handle64a.exe" />
    <None Remove="Resources\Servy.Service.exe" />
    <None Remove="Resources\Servy.Service.pdb" />
    <None Remove="Resources\Icons\Error.png" />
    <None Remove="Resources\Icons\Info.png" />
    <None Remove="Resources\Icons\Warning.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.manager.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="servy.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\handle64.exe" />
    <EmbeddedResource Include="Resources\handle64a.exe" />
    <EmbeddedResource Include="Resources\Servy.Service.exe" />
    <EmbeddedResource Include="Resources\Servy.Service.pdb" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\Error.png" />
    <Resource Include="Resources\Icons\Info.png" />
    <Resource Include="Resources\Icons\Warning.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Controls\PidBadgeControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Controls\ServiceListControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Resources\Strings.Designer.cs">
      <DependentUpon>Strings.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="Views\DependenciesView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\ConsoleView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\ServiceSearchUserControl.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Strings.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Servy.Manager.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Servy.Core\Servy.Core.csproj" />
    <ProjectReference Include="..\Servy.Infrastructure\Servy.Infrastructure.csproj" />
    <ProjectReference Include="..\Servy.UI\Servy.UI.csproj" />
  </ItemGroup>

</Project>

<UserControl x:Class="Servy.Manager.Views.Controls.ServiceListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Servy.UI.Converters;assembly=Servy.UI"
             xmlns:resx="clr-namespace:Servy.Manager.Resources"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             AutomationProperties.AutomationId="ServiceListControl"
             AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ServiceListControl_HelpText}"
             AutomationProperties.Name="{x:Static resx:Strings.Automation_ServiceListControl_Name}">

  <UserControl.Resources>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
  </UserControl.Resources>

  <Border Margin="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <DockPanel Margin="6"
                       FocusVisualStyle="{x:Null}"
                       Focusable="True">
        <TextBox Width="164"
                         Height="24"
                         Margin="0,0,6,0"
                         VerticalContentAlignment="Center"
                         SnapsToDevicePixels="False"
                         UseLayoutRounding="False"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         AutomationProperties.AutomationId="SidebarSearchTextBox"
                         AutomationProperties.HelpText="{x:Static resx:Strings.Automation_SidebarSearchTextBox_HelpText}"
                         AutomationProperties.Name="{x:Static resx:Strings.Automation_SidebarSearchTextBox_Name}"
                         Text="{Binding SearchText, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
          </TextBox.InputBindings>
        </TextBox>

        <Button Width="92"
                        Height="24"
                        AutomationProperties.AutomationId="SidebarSearchButton"
                        AutomationProperties.Name="{Binding SearchButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Command="{Binding SearchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Content="{Binding SearchButtonText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InverseBooleanConverter}}" />
      </DockPanel>

      <DataGrid Grid.Row="1"
                      AutoGenerateColumns="False"
                      AutomationProperties.AutomationId="SidebarServicesDataGrid"
                      AutomationProperties.Name="{x:Static resx:Strings.Automation_SidebarServicesDataGrid_Name}"
                      Background="Transparent"
                      BorderBrush="#757575"
                      BorderThickness="1"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="True"
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      FocusVisualStyle="{x:Null}"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      IsSynchronizedWithCurrentItem="False"
                      ItemsSource="{Binding Services, RelativeSource={RelativeSource AncestorType=UserControl}, IsAsync=True}"
                      ScrollViewer.CanContentScroll="True"
                      SelectedItem="{Binding SelectedService, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.ScrollUnit="Pixel"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      Style="{StaticResource DataGridSelectionColorsStyle}">
        <DataGrid.Resources>
          <Style TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="10,7" />
          </Style>

          <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
              </Trigger>
            </Style.Triggers>
          </Style>

          <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                  <Border Padding="0" Background="{TemplateBinding Background}">
                    <ContentPresenter VerticalAlignment="Center" />
                  </Border>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="BorderThickness" Value="0" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </DataGrid.Resources>

        <DataGrid.Columns>
          <DataGridTemplateColumn Width="*"
                                            CanUserReorder="False"
                                            CanUserResize="False"
                                            SortMemberPath="Name">
            <DataGridTemplateColumn.Header>
              <TextBlock AutomationProperties.Name="{x:Static resx:Strings.Automation_ServiceNameHeader_Name}"
                                       FontWeight="SemiBold"
                                       Text="{x:Static resx:Strings.Column_Service}" />
            </DataGridTemplateColumn.Header>

            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Border Padding="10,6"
                                        Background="Transparent"
                                        BorderBrush="#F0F0F0"
                                        BorderThickness="0,0,0,1">
                  <TextBlock VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding Name}"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>
  </Border>
</UserControl>

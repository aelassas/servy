<Application x:Class="Servy.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Row hover background color across DataGrid controls -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F5F5" />

    <!-- Shared pill-style button used in view toolbars -->
    <Style x:Key="ToolbarPillButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="#1B7F9F" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,1" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="#25A2C9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="#146078" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Remaps the built-in SystemColors selection keys so every DataGrid gets consistent
         selection colors instead of the native Windows highlight color.
         Apply via Style="{StaticResource DataGridSelectionColorsStyle}". -->
    <Style x:Key="DataGridSelectionColorsStyle" TargetType="DataGrid">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
      </Style.Resources>
    </Style>

    <!-- Same remap as DataGridSelectionColorsStyle above, for TreeViewItem-based surfaces
         (e.g. DependenciesView). Consume via BasedOn="{StaticResource TreeViewItemSelectionColorsStyle}". -->
    <Style x:Key="TreeViewItemSelectionColorsStyle" TargetType="TreeViewItem">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
      </Style.Resources>
    </Style>
  </Application.Resources>
</Application>

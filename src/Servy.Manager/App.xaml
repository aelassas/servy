<Application x:Class="Servy.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Product accent, used for toolbar pill buttons, the PID badge and the performance graphs -->
    <SolidColorBrush x:Key="AccentBrush" Color="#1B7F9F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#25A2C9" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#146078" />

    <!-- 1px border on framed controls -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#757575" />

    <!-- Performance graph brushes -->
    <SolidColorBrush x:Key="AccentFillBrush" Color="#80C3ECFA" />
    <SolidColorBrush x:Key="AccentGridPenBrush" Color="#EBEBEB" />
    <SolidColorBrush x:Key="AccentBackgroundBrush" Color="#FFFFFF" />

    <!-- Row hover background color across DataGrid controls -->
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F5F5F5" />

    <!-- Selection highlight colors used to remap SystemColors across DataGrid and TreeViewItem controls -->
    <Color x:Key="SelectionHighlightColor">#0078D7</Color>
    <Color x:Key="SelectionHighlightTextColor">White</Color>

    <!-- Shared pill-style button used in view toolbars -->
    <Style x:Key="ToolbarPillButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    CornerRadius="2"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,0,0,1" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="border" Property="Background" Value="{StaticResource AccentPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Remaps the built-in SystemColors selection keys so every DataGrid gets consistent
         selection colors instead of the native Windows highlight color.
         Apply via Style="{StaticResource DataGridSelectionColorsStyle}". -->
    <Style x:Key="DataGridSelectionColorsStyle" TargetType="DataGrid">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SelectionHighlightColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SelectionHighlightColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource SelectionHighlightTextColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource SelectionHighlightTextColor}" />
      </Style.Resources>
    </Style>

    <!-- Same remap as DataGridSelectionColorsStyle above, for TreeViewItem-based surfaces
         (e.g. DependenciesView). Consume via BasedOn="{StaticResource TreeViewItemSelectionColorsStyle}". -->
    <Style x:Key="TreeViewItemSelectionColorsStyle" TargetType="TreeViewItem">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource SelectionHighlightColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource SelectionHighlightColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource SelectionHighlightTextColor}" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource SelectionHighlightTextColor}" />
      </Style.Resources>
    </Style>
  </Application.Resources>
</Application>

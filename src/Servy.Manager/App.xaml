<Application x:Class="Servy.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Servy.Manager"
             xmlns:system="clr-namespace:System;assembly=mscorlib">
  <Application.Resources>
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="SelectionInactiveHighlightBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="SelectionHighlightTextBrush" Color="White" />
    <SolidColorBrush x:Key="SelectionInactiveHighlightTextBrush" Color="White" />

    <!-- Shared DataGrid style: remaps the built-in SystemColors selection keys to the brushes
         above so every DataGrid gets consistent selection colors instead of the native Windows
         highlight color. Apply via Style="{StaticResource DataGridSelectionColorsStyle}".
         NOTE: colors below are duplicated (not StaticResource-referenced) because WPF's markup
         compiler cannot resolve a StaticResource-as-object-element redirect inside the deferred
         content of a Style.Resources/merged dictionary (throws a XamlParseException about
         StaticResourceHolder at InitializeComponent time) - keep these in sync with the brushes
         above if their colors ever change. -->
    <Style x:Key="DataGridSelectionColorsStyle" TargetType="DataGrid">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
      </Style.Resources>
    </Style>
  </Application.Resources>
</Application>

<Application x:Class="Servy.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <!-- Canonical selection colors (WPF's markup compiler can't resolve a StaticResource-as-
         object-element redirect inside the deferred content of a Style.Resources block, so the
         styles below duplicate these as literals instead of referencing them - keep all copies
         in sync if these ever change). -->
    <!-- SelectionColor: #0078D7, SelectionTextColor: White -->

    <!-- Remaps the built-in SystemColors selection keys so every DataGrid gets consistent
         selection colors instead of the native Windows highlight color.
         Apply via Style="{StaticResource DataGridSelectionColorsStyle}". -->
    <Style x:Key="DataGridSelectionColorsStyle" TargetType="DataGrid">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
      </Style.Resources>
    </Style>

    <!-- Same remap as DataGridSelectionColorsStyle above, for TreeViewItem-based surfaces
         (e.g. DependenciesView). Consume via BasedOn="{StaticResource TreeViewItemSelectionColorsStyle}". -->
    <Style x:Key="TreeViewItemSelectionColorsStyle" TargetType="TreeViewItem">
      <Style.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White" />
      </Style.Resources>
    </Style>
  </Application.Resources>
</Application>

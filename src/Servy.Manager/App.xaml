<Application x:Class="Servy.Manager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Servy.Manager"
             xmlns:system="clr-namespace:System;assembly=mscorlib">
  <Application.Resources>
    <SolidColorBrush x:Key="SelectionHighlightBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="SelectionInactiveHighlightBrush" Color="#0078D7" />
    <SolidColorBrush x:Key="SelectionHighlightTextBrush" Color="White" />
    <SolidColorBrush x:Key="SelectionInactiveHighlightTextBrush" Color="White" />
  </Application.Resources>
</Application>

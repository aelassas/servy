<Window x:Class="Servy.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:Servy"
        xmlns:resx="clr-namespace:Servy.Resources"
        xmlns:viewmodels="clr-namespace:Servy.ViewModels"
        xmlns:converters="clr-namespace:Servy.UI.Converters;assembly=Servy.UI"
        xmlns:helpers="clr-namespace:Servy.Helpers"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="Servy"
        MinWidth="700"
        MinHeight="770"
        SizeToContent="WidthAndHeight"
        ResizeMode="CanMinimize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.Name="{x:Static resx:Strings.Automation_ConfigMainWindow_Name}"
        AutomationProperties.AutomationId="ConfigMainWindow"
        AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ConfigMainWindow_HelpText}">
  <Window.Resources>
    <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

    <!-- Tab Grid Dimensions -->
    <sys:Double x:Key="TabGridMinHeight">520</sys:Double>
    <GridLength x:Key="ColumnWidthMain">390</GridLength>
    <GridLength x:Key="ColumnWidthAction">100</GridLength>

    <!-- Button Dimensions -->
    <sys:Double x:Key="ActionButtonWidth">90</sys:Double>
    <sys:Double x:Key="ActionButtonHeight">22</sys:Double>
    <sys:Double x:Key="BottomButtonWidth">80</sys:Double>
    <sys:Double x:Key="BottomButtonHeight">22</sys:Double>

    <!-- Implicit Action/Browse Button Style for Grid columns -->
    <Style TargetType="Button">
      <Setter Property="Width" Value="{StaticResource ActionButtonWidth}" />
      <Setter Property="Height" Value="{StaticResource ActionButtonHeight}" />
    </Style>

    <!-- Bottom Panel Button Style -->
    <Style x:Key="BottomButtonStyle" TargetType="Button">
      <Setter Property="Width" Value="{StaticResource BottomButtonWidth}" />
      <Setter Property="Height" Value="{StaticResource BottomButtonHeight}" />
      <Setter Property="Margin" Value="5" />
    </Style>

    <!-- Standard Tab Grid Style - Keyed so it doesn't pollute layout Grids -->
    <Style x:Key="TabGridStyle" TargetType="Grid">
      <Setter Property="Margin" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="MinHeight" Value="{StaticResource TabGridMinHeight}" />
    </Style>

    <!-- Default Single-Line Field Style -->
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="MaxHeight" Value="22" />
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="AcceptsReturn" Value="False" />
      <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="False" />
      <Setter Property="UseLayoutRounding" Value="False" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- Default PasswordBox Field Style -->
    <Style TargetType="PasswordBox">
      <Setter Property="Height" Value="22" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="SnapsToDevicePixels" Value="False" />
      <Setter Property="UseLayoutRounding" Value="False" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
      <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top"
          Height="28"
          AutomationProperties.Name="{x:Static resx:Strings.Automation_MainMenu_Name}"
          AutomationProperties.AutomationId="MainMenu"
          AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MainMenu_HelpText}">
      <MenuItem Header="{x:Static resx:Strings.Menu_Export}"
                AutomationProperties.Name="{x:Static resx:Strings.Menu_Export}"
                AutomationProperties.AutomationId="MenuExport"
                AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuExport_HelpText}">
        <MenuItem Header="{x:Static resx:Strings.Menu_ExportXml}"
                  Command="{Binding ExportXmlCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_ExportXml}"
                  AutomationProperties.AutomationId="MenuExportXml"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuExportXml_HelpText}" />
        <MenuItem Header="{x:Static resx:Strings.Menu_ExportJson}"
                  Command="{Binding ExportJsonCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_ExportJson}"
                  AutomationProperties.AutomationId="MenuExportJson"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuExportJson_HelpText}" />
      </MenuItem>

      <MenuItem Header="{x:Static resx:Strings.Menu_Import}"
                AutomationProperties.Name="{x:Static resx:Strings.Menu_Import}"
                AutomationProperties.AutomationId="MenuImport"
                AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuImport_HelpText}">
        <MenuItem Header="{x:Static resx:Strings.Menu_ImportXml}"
                  Command="{Binding ImportXmlCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_ImportXml}"
                  AutomationProperties.AutomationId="MenuImportXml"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuImportXml_HelpText}" />
        <MenuItem Header="{x:Static resx:Strings.Menu_ImportJson}"
                  Command="{Binding ImportJsonCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_ImportJson}"
                  AutomationProperties.AutomationId="MenuImportJson"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuImportJson_HelpText}" />
      </MenuItem>

      <MenuItem Header="{x:Static resx:Strings.Menu_Manager}"
                Command="{Binding ManagerCommand}"
                IsEnabled="{Binding IsManagerAppAvailable}"
                AutomationProperties.Name="{x:Static resx:Strings.Menu_Manager}"
                AutomationProperties.AutomationId="MenuManager"
                AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuManager_HelpText}" />

      <MenuItem Header="{x:Static resx:Strings.Menu_ClearAll}"
                Command="{Binding ClearFormCommand}"
                AutomationProperties.Name="{x:Static resx:Strings.Menu_ClearAll}"
                AutomationProperties.AutomationId="MenuClearAll"
                AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuClearAll_HelpText}" />

      <MenuItem Header="{x:Static resx:Strings.Menu_Help}"
                AutomationProperties.Name="{x:Static resx:Strings.Menu_Help}"
                AutomationProperties.AutomationId="MenuHelp"
                AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuHelp_HelpText}">
        <MenuItem Header="{x:Static resx:Strings.Menu_Doc}"
                  Command="{Binding OpenDocumentationCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_Doc}"
                  AutomationProperties.AutomationId="MenuDoc"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuDoc_HelpText}" />
        <MenuItem Header="{x:Static resx:Strings.Menu_CheckUpdates}"
                  Command="{Binding CheckUpdatesCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_CheckUpdates}"
                  AutomationProperties.AutomationId="MenuCheckUpdates"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuCheckUpdates_HelpText}" />
        <MenuItem Header="{x:Static resx:Strings.Menu_About}"
                  Command="{Binding OpenAboutDialogCommand}"
                  AutomationProperties.Name="{x:Static resx:Strings.Menu_About}"
                  AutomationProperties.AutomationId="MenuAbout"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_MenuAbout_HelpText}" />
      </MenuItem>
    </Menu>

    <Grid Style="{x:Null}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0"
                  VerticalAlignment="Stretch"
                  AutomationProperties.Name="{x:Static resx:Strings.Automation_ConfigurationTabControl_Name}"
                  AutomationProperties.AutomationId="ConfigurationTabControl"
                  AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ConfigurationTabControl_HelpText}">

        <TabItem Header="{x:Static resx:Strings.Label_MainTab}"
                 AutomationProperties.Name="{x:Static resx:Strings.Label_MainTab}"
                 AutomationProperties.AutomationId="TabItemMain"
                 AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TabItemMain_HelpText}">
          <Grid Style="{StaticResource TabGridStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="{StaticResource ColumnWidthMain}" />
              <ColumnDefinition Width="{StaticResource ColumnWidthAction}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ServiceName}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding ServiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxServiceName_Name}"
                     AutomationProperties.AutomationId="TextBoxServiceName"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxServiceName_HelpText}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ServiceDisplayName}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding ServiceDisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxServiceDisplayName_Name}"
                     AutomationProperties.AutomationId="TextBoxServiceDisplayName"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxServiceDisplayName_HelpText}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_ServiceDisplayName}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ServiceDescription}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding ServiceDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxServiceDescription_Name}"
                     AutomationProperties.AutomationId="TextBoxServiceDescription"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxServiceDescription_HelpText}" />

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ProcessPath}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="4" Grid.Column="1"
                     Margin="0,5"
                     Text="{Binding ProcessPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxProcessPath_Name}"
                     AutomationProperties.AutomationId="TextBoxProcessPath"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxProcessPath_HelpText}" />
            <Button Grid.Row="4" Grid.Column="2"
                    Content="{x:Static resx:Strings.Button_Browse}"
                    Command="{Binding BrowseProcessPathCommand}"
                    Margin="5,5,0,5" HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static resx:Strings.Automation_ButtonBrowseProcessPath_Name}"
                    AutomationProperties.AutomationId="ButtonBrowseProcessPath"
                    AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ButtonBrowseProcessPath_HelpText}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_ProcessPath}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StartupDirectory}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="6" Grid.Column="1"
                     Margin="0,5"
                     Text="{Binding StartupDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxStartupDirectory_Name}"
                     AutomationProperties.AutomationId="TextBoxStartupDirectory"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxStartupDirectory_HelpText}" />
            <Button Grid.Row="6" Grid.Column="2"
                    Content="{x:Static resx:Strings.Button_Browse}"
                    Command="{Binding BrowseStartupDirectoryCommand}"
                    Margin="5,5,0,5" HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static resx:Strings.Automation_ButtonBrowseStartupDirectory_Name}"
                    AutomationProperties.AutomationId="ButtonBrowseStartupDirectory"
                    AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ButtonBrowseStartupDirectory_HelpText}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_StartupDirectory}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="8" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ProcessParameters}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding ProcessParameters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Height="80" MinHeight="80" MaxHeight="80"
                     TextWrapping="Wrap" AcceptsReturn="False"
                     MaxLines="2147483647" VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxProcessParameters_Name}"
                     AutomationProperties.AutomationId="TextBoxProcessParameters"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxProcessParameters_HelpText}" />
            <TextBlock Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_ProcessParameters}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="10" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StartupType}"
                       Margin="0,5,10,5" />
            <ComboBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="0,5"
                      ItemsSource="{Binding StartupTypes}"
                      DisplayMemberPath="DisplayName"
                      SelectedValue="{Binding SelectedStartupType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Value"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_StartupType}"
                      AutomationProperties.AutomationId="ComboBoxStartupType"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ComboBoxStartupType_HelpText}" />

            <TextBlock Grid.Row="11" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_ProcessPriority}"
                       Margin="0,5,10,5" />
            <ComboBox Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="0,5"
                      ItemsSource="{Binding ProcessPriorities}"
                      DisplayMemberPath="DisplayName"
                      SelectedValue="{Binding SelectedProcessPriority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Value"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_ProcessPriority}"
                      AutomationProperties.AutomationId="ComboBoxProcessPriority"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ComboBoxProcessPriority_HelpText}" />

            <TextBlock Grid.Row="12" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_CpuAffinity}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding CpuAffinity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxCpuAffinity_Name}"
                     AutomationProperties.AutomationId="TextBoxCpuAffinity"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxCpuAffinity_HelpText}" />
            <TextBlock Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_CpuAffinity}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="14" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StartTimeout}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding StartTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxStartTimeout_Name}"
                     AutomationProperties.AutomationId="TextBoxStartTimeout"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxStartTimeout_HelpText}" />
            <TextBlock Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_StartTimeout}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="16" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StopTimeout}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="16" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     Text="{Binding StopTimeout, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxStopTimeout_Name}"
                     AutomationProperties.AutomationId="TextBoxStopTimeout"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxStopTimeout_HelpText}" />
            <TextBlock Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_StopTimeout}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <CheckBox Grid.Row="18" Grid.Column="1" Grid.ColumnSpan="2"
                      IsChecked="{Binding EnableConsoleUI, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,10"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_EnableConsoleUI}"
                      AutomationProperties.AutomationId="CheckBoxEnableConsoleUI"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_CheckBoxEnableConsoleUI_HelpText}">
              <CheckBox.Content>
                <TextBlock Text="{x:Static resx:Strings.Label_EnableConsoleUI}" TextWrapping="Wrap" />
              </CheckBox.Content>
            </CheckBox>
          </Grid>
        </TabItem>

        <TabItem Header="{x:Static resx:Strings.Label_LoggingTab}"
                 AutomationProperties.Name="{x:Static resx:Strings.Label_LoggingTab}"
                 AutomationProperties.AutomationId="TabItemLogging"
                 AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TabItemLogging_HelpText}">
          <Grid Style="{StaticResource TabGridStyle}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="{StaticResource ColumnWidthMain}" />
              <ColumnDefinition Width="{StaticResource ColumnWidthAction}" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StdoutPath}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="0" Grid.Column="1"
                     Margin="0,5"
                     Text="{Binding StdoutPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxStdoutPath_Name}"
                     AutomationProperties.AutomationId="TextBoxStdoutPath"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxStdoutPath_HelpText}" />
            <Button Grid.Row="0" Grid.Column="2"
                    Content="{x:Static resx:Strings.Button_Browse}"
                    Command="{Binding BrowseStdoutPathCommand}"
                    Margin="5,5,0,5" HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static resx:Strings.Automation_ButtonBrowseStdout_Name}"
                    AutomationProperties.AutomationId="ButtonBrowseStdout"
                    AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ButtonBrowseStdout_HelpText}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_StderrPath}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="1" Grid.Column="1"
                     Margin="0,5"
                     Text="{Binding StderrPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxStderrPath_Name}"
                     AutomationProperties.AutomationId="TextBoxStderrPath"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxStderrPath_HelpText}" />
            <Button Grid.Row="1" Grid.Column="2"
                    Content="{x:Static resx:Strings.Button_Browse}"
                    Command="{Binding BrowseStderrPathCommand}"
                    Margin="5,5,0,5" HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Static resx:Strings.Automation_ButtonBrowseStderr_Name}"
                    AutomationProperties.AutomationId="ButtonBrowseStderr"
                    AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ButtonBrowseStderr_HelpText}" />

            <CheckBox Grid.Row="2" Grid.Column="1"
                      Content="{x:Static resx:Strings.Label_EnableSizeRotation}"
                      IsChecked="{Binding EnableSizeRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,5"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_EnableSizeRotation}"
                      AutomationProperties.AutomationId="CheckBoxEnableSizeRotation"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_CheckBoxEnableSizeRotation_HelpText}" />

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_RotationSize}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="3" Grid.Column="1"
                     Margin="0,5"
                     IsEnabled="{Binding EnableSizeRotation}"
                     Text="{Binding RotationSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxRotationSize_Name}"
                     AutomationProperties.AutomationId="TextBoxRotationSize"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxRotationSize_HelpText}" />
            <TextBlock Grid.Row="3" Grid.Column="2"
                       Text="{x:Static resx:Strings.Label_RotationSizeUnit}"
                       VerticalAlignment="Center"
                       Margin="5,5,0,5" />

            <CheckBox Grid.Row="4" Grid.Column="1"
                      Content="{x:Static resx:Strings.Label_EnableDateRotation}"
                      IsChecked="{Binding EnableDateRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,5"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_EnableDateRotation}"
                      AutomationProperties.AutomationId="CheckBoxEnableDateRotation"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_CheckBoxEnableDateRotation_HelpText}" />

            <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_DateRotationType}"
                       Margin="0,5,10,5" />
            <ComboBox Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                      Margin="0,5"
                      ItemsSource="{Binding DateRotationTypes}"
                      DisplayMemberPath="DisplayName"
                      SelectedValue="{Binding SelectedDateRotationType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Value"
                      IsEnabled="{Binding EnableDateRotation}"
                      AutomationProperties.Name="{x:Static resx:Strings.Label_DateRotationType}"
                      AutomationProperties.AutomationId="ComboBoxDateRotationType"
                      AutomationProperties.HelpText="{x:Static resx:Strings.Automation_ComboBoxDateRotationType_HelpText}" />
            <TextBlock Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_DateRotation}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

            <TextBlock Grid.Row="7" Grid.Column="0"
                       Text="{x:Static resx:Strings.Label_MaxRotations}"
                       Margin="0,5,10,5" />
            <TextBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,5"
                     IsEnabled="{Binding EnableRotation}"
                     Text="{Binding MaxRotations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="{x:Static resx:Strings.Automation_TextBoxMaxRotations_Name}"
                     AutomationProperties.AutomationId="TextBoxMaxRotations"
                     AutomationProperties.HelpText="{x:Static resx:Strings.Automation_TextBoxMaxRotations_HelpText}" />
            <TextBlock Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                       Text="{x:Static resx:Strings.Info_MaxRotations}"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap" />

